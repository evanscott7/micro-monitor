<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts Lighthouse at login. Installed by kiosk/install-login-item.sh into ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.lighthouse.kiosk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>/Users/evan/AI/projects/micro-monitor/kiosk/build/Lighthouse.app</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
